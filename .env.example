ORCH_REDIS_URL=redis://localhost:6379/0

# "development" (default): missing LLM key falls back to the mock provider,
# sandbox unavailable falls back to unsandboxed execution.
# "production": both of those fail fast at startup/task-time instead.
ORCH_ENVIRONMENT=development

# multi-LLM: "mock" (default, no key needed), "anthropic", "openai", or
# "ollama" (local model -- e.g. Qwen -- no key, no external network call;
# start it with the Docker commands in README, then pull qwen2.5:3b)
ORCH_LLM_PROVIDER=mock
ORCH_ANTHROPIC_API_KEY=
ORCH_ANTHROPIC_MODEL=claude-sonnet-5
ORCH_OPENAI_API_KEY=
ORCH_OPENAI_MODEL=gpt-4o-mini
ORCH_OLLAMA_BASE_URL=http://localhost:11434
ORCH_OLLAMA_MODEL=qwen2.5:3b
# CPU-only local models may need a larger timeout (for example 180 seconds).
ORCH_LLM_TIMEOUT_SECONDS=20
ORCH_LLM_MAX_ATTEMPTS=2

# Heterogeneous agent pool (optional): "name|provider|model" entries
# separated by ";". When set, POST /workers/scale round-robins new
# workers across these profiles -- each one is a real separate process
# with its own LLM provider, not a simulated difference. Unset (default):
# every worker uses the single ORCH_LLM_PROVIDER above, as before.
# Example: a local Qwen agent alongside a hosted Claude agent:
# ORCH_AGENT_PROFILES_RAW=qwen|ollama|qwen2.5:3b;claude|anthropic|claude-sonnet-5
ORCH_AGENT_PROFILES_RAW=

# durable queue: task lease (visibility timeout) + retry
ORCH_TASK_LEASE_SECONDS=90
ORCH_TASK_MAX_ATTEMPTS=3
ORCH_REAPER_INTERVAL_SECONDS=15

# worker registry (Redis-backed heartbeat/TTL)
ORCH_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
ORCH_WORKER_TTL_SECONDS=15
ORCH_WORKER_STOP_GRACE_SECONDS=10

# sandboxed task execution (see sandbox/)
ORCH_SANDBOX_ENABLED=true
ORCH_SANDBOX_IMAGE=agent-orchestrator-sandbox:latest
ORCH_SANDBOX_TIMEOUT_SECONDS=30
ORCH_SANDBOX_MEMORY_MB=256
ORCH_SANDBOX_CPUS=1.0

# optional shared-secret auth; unset keeps local/demo usage frictionless.
# set to require the X-API-Key header on mutating endpoints.
ORCH_API_KEY=
ORCH_RATE_LIMIT_PER_MINUTE=120
